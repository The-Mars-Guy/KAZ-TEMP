# Configuration for Father Kaz Ligeza — https://frkazligeza.com
#
# Copy to `.env.local` for local development. Only VITE_-prefixed variables are
# exposed to the browser bundle — NEVER put secrets here.

# --- Frontend (client-visible) -------------------------------------------

# Canonical site origin used for canonical URLs, Open Graph, and the sitemap.
# Optional. Defaults to https://frkazligeza.com (src/config/site.js).
# VITE_SITE_URL=https://frkazligeza.com

# Contact form delivery endpoint (Cloudflare Worker / Pages Function), e.g.
# /api/contact. When EMPTY the form stays in its honest "not connected" state
# and never reports a message as sent. Set it only once the backend exists.
# VITE_CONTACT_ENDPOINT=

# Show draft content. Default: true under `vite dev`, false in production
# builds. Set true on a staging/preview deployment to review draft fixtures;
# NEVER enable on the production site.
# VITE_SHOW_DRAFTS=false

# --- Server-side only (set in Cloudflare, NOT in the frontend build) ------
# Stripe secret keys, the D1 database binding, and email-provider API keys live
# in the Cloudflare Worker environment. They must never appear here or in any
# VITE_ variable. See DEPLOYMENT.md.
